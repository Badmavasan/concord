# Copy to .env (docker compose) or export before `npm start`. All optional except JWT_SECRET in production.
JWT_SECRET=change-me-to-a-long-random-string
# Public URL used in invite links and to decide whether session cookies are marked Secure (https)
APP_URL=https://concord.example.org
# Let anyone create an account on the sign-in page (true), or only through invitation links (false).
OPEN_REGISTRATION=true
# Force the Secure cookie flag on/off regardless of APP_URL (default: on when APP_URL is https)
# COOKIE_SECURE=true
# Set to false if the app is NOT behind a reverse proxy
# TRUST_PROXY=false
# Docker: host port that nginx proxies to (container always listens on 4321 internally)
HOST_PORT=4700
# Bare-metal install: port the Node server listens on
PORT=4700
# Where the SQLite file and PDFs are stored (defaults to server/ when unset; docker sets /data)
# DATA_DIR=/data
# Outgoing email: invitations, "you were added" notices and password resets.
# These are OVH's settings for the mailboxes behind webmail (MX Plan / Zimbra): create the
# sending mailbox in the OVH control panel first, then paste its password below.
# smtp.mail.ovh.net:465 with SMTP_SECURE=true is TLS from the first byte; ssl0.ovh.net works
# too, and 587 with SMTP_SECURE=false is the STARTTLS alternative if 465 is blocked.
# SMTP_USER must be the full address, and OVH only sends as a mailbox you own, so the address
# in MAIL_FROM has to match it. With SMTP_HOST or SMTP_PASSWORD empty nothing is sent: links
# are written to the server log and invitation links are shown to the owner in the UI.
# Check the settings without touching the app:  docker compose exec -u node app node cli.js mail test you@example.com
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.org
SMTP_PASSWORD=
MAIL_FROM="Concord <noreply@example.org>"
# Optional: where replies to reset emails go (invitations reply to the inviter automatically)
# MAIL_REPLY_TO=you@univ.edu
# How long invitation and password-reset links stay valid
LINK_TTL_HOURS=24
