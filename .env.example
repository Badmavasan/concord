# Copy to .env (docker compose) or export before `npm start`. All optional except JWT_SECRET in production.
JWT_SECRET=change-me-to-a-long-random-string
# Public URL used in invite links and to decide whether session cookies are marked Secure (https)
APP_URL=https://review.example.org
# Accounts can only be created through invite links (recommended). Create the first owner with the CLI.
OPEN_REGISTRATION=false
# Force the Secure cookie flag on/off regardless of APP_URL (default: on when APP_URL is https)
# COOKIE_SECURE=true
# Set to false if the app is NOT behind a reverse proxy
# TRUST_PROXY=false
# Host port when using docker compose
PORT=4321
# Where the SQLite file and PDFs are stored (defaults to server/ when unset; docker sets /data)
# DATA_DIR=/data
# SMTP for emailing invites. If unset, invite links are shown in the UI to copy/share manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Concord <noreply@example.org>"
